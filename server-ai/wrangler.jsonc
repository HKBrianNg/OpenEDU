{
  "name": "openedu-server-ai",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-29",
  "containers": [
    {
      "class_name": "ServerAI",
      "image": "./Dockerfile",
      "max_instances": 3,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SERVER_AI", "class_name": "ServerAI" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ServerAI"] }
  ]
}
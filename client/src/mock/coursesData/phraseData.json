{"id":255,"tag":"10-03","scenario":"kiddiespeak","level":"kindergarten","phrase":"I'm full.","phrase_cn":"我吃饱了。","phrase_tw":"我吃飽了。"},
{"id":256,"tag":"10-04","scenario":"kiddiespeak","level":"kindergarten","phrase":"I want to watch a cartoon.","phrase_cn":"我想看动画片。","phrase_tw":"我想看卡通。"},
{"id":257,"tag":"10-05","scenario":"kiddiespeak","level":"kindergarten","phrase":"Read a book to me, please.","phrase_cn":"请给我读一本书。","phrase_tw":"請讀一本書給我聽。"},
{"id":258,"tag":"10-06","scenario":"kiddiespeak","level":"kindergarten","phrase":"I'm awake.","phrase_cn":"我醒了。","phrase_tw":"我醒囉。"},
{"id":259,"tag":"10-07","scenario":"kiddiespeak","level":"kindergarten","phrase":"Dad, pick me up.","phrase_cn":"爸爸，抱。","phrase_tw":"爸爸，抱我。"},
{"id":260,"tag":"10-08","scenario":"kiddiespeak","level":"kindergarten","phrase":"Give me a piggy back ride.","phrase_cn":"背背我。","phrase_tw":"背我。"},
{"id":261,"tag":"10-09","scenario":"kiddiespeak","level":"kindergarten","phrase":"Daddy, play with me!","phrase_cn":"爸爸，跟我玩。","phrase_tw":"爸爸，陪我玩！"},
{"id":262,"tag":"10-10","scenario":"kiddiespeak","level":"kindergarten","phrase":"Can I play a little longer?","phrase_cn":"我可以再玩一会儿吗？","phrase_tw":"我可以再玩一下嗎？"},
{"id":263,"tag":"10-11","scenario":"kiddiespeak","level":"kindergarten","phrase":"Mommy, I want to drink some water.","phrase_cn":"妈妈，我想喝水。","phrase_tw":"媽媽，我想喝水。"},
{"id":264,"tag":"10-12","scenario":"kiddiespeak","level":"kindergarten","phrase":"I'm hungry.","phrase_cn":"我肚子饿了。","phrase_tw":"我肚子餓了。"},
{"id":265,"tag":"10-13","scenario":"kiddiespeak","level":"kindergarten","phrase":"I don't feel good.","phrase_cn":"我不舒服。","phrase_tw":"我不太舒服。"},
{"id":266,"tag":"10-14","scenario":"kiddiespeak","level":"kindergarten","phrase":"It's so itchy.","phrase_cn":"好痒啊！","phrase_tw":"好癢喔！"},
{"id":267,"tag":"10-15","scenario":"kiddiespeak","level":"kindergarten","phrase":"That hurts.","phrase_cn":"好痛啊。","phrase_tw":"好痛喔。"},
{"id":268,"tag":"10-16","scenario":"kiddiespeak","level":"kindergarten","phrase":"I'll be good!","phrase_cn":"我会听话的！","phrase_tw":"我會乖乖的！"},
{"id":269,"tag":"10-17","scenario":"kiddiespeak","level":"kindergarten","phrase":"Can I have some candy?","phrase_cn":"我可以吃颗糖吗？","phrase_tw":"我可以吃糖果嗎？"},

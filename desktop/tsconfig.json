{
  "compilerOptions": {
    "target": "ES2019",
    "useDefineForClassFields": true,
    "lib": ["ES2019", "ES2020", "DOM", "DOM.Iterable", "ES2022.error"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]                    // ← 加这行
  },
  "include": [
    "src/**/*",
    "electron/**/*.ts",                  // ← 加这行
    "types/**/*.d.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"                   // vitest 未安装，测试文件不参与编译
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
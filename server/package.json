{
  "name": "server",
  "version": "1.0.0",
  "description": "Content Management Platform",
  "type": "module",
  "engines": {
    "node":">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:cycle-1": "vitest --project auth-registration",
    "test:cycle-2": "vitest --project auth-login",
    "test:cycle-3": "vitest --project auth-protected-routes",
    "test:cycle-4": "vitest --project auth-internationalization",
    "test:cycle-5": "vitest --project users-profile",
    "test:cycle-6": "vitest --project users-password",
    "test:cycle-7": "vitest --project users-avatar",
    "test:cycle-8": "vitest --project users-avatar-delete",
    "test:cycle-9": "vitest --project users-public-profile",
    "test:cycle-10": "vitest --project users-account-delete",
    "test:cycle-11": "vitest --project admin-users",
    "test:cycle-12": "vitest --project users-list",

    "test:watch": "vitest"
  },
  "main": "src/index.js",
  "keywords": [],
  "author": "Ng Shun Chiang, Brian",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}

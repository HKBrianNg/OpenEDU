import React, { useRef, useEffect } from 'react';
import type { JunglePiece, CellType, DragState } from './types';
import { NAME_MAP, CELL_SIZE, BOARD_WIDTH, BOARD_HEIGHT } from './types';
import { getValidMoves, getPieceAt } from './board';

interface Props {
  cellType: CellType[][];
  pieces: JunglePiece[];
  selectedPiece: JunglePiece | null;
  drag: DragState;
  flashFrame: number;
  onMouseDown: (e: MouseEvent) => void;
  onMouseMove: (e: MouseEvent) => void;
  onMouseUp: () => void;
}

export const JungleGame: React.FC<Props> = ({
  cellType,
  pieces,
  selectedPiece,
  drag,
  flashFrame,
  onMouseDown,
  onMouseMove,
  onMouseUp
}) => {
  const canvasRef = useRef<HTMLCanvasElement>(null);

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // 防御：棋盘数据未就绪直接退出绘制
    if (!cellType || cellType.length < 9) return;

    let animId: number;
    const draw = () => {
      ctx.clearRect(0, 0, BOARD_WIDTH, BOARD_HEIGHT);

      // 绘制棋盘格子，y镜像翻转：红在下蓝在上
      for (let y = 0; y < 9; y++) {
        // 防止cellType[y]为undefined
        const row = cellType[y];
        if (!row) continue;
        for (let x = 0; x < 7; x++) {
          const ct = row[x];
          const visualY = 8 - y;
          ctx.fillStyle = '#f3e2bc';
          if (ct === 'river') ctx.fillStyle = '#63a8e8';
          if (ct === 'trap') ctx.fillStyle = '#ffd8a8';
          if (ct === 'den') ctx.fillStyle = '#ffaaaa';
          ctx.fillRect(x * CELL_SIZE, visualY * CELL_SIZE, CELL_SIZE - 1, CELL_SIZE - 1);
        }
      }

      // 绘制可走点
      if (selectedPiece) {
        const valid = getValidMoves(pieces, selectedPiece, cellType);
        for (const [mx, my] of valid) {
          const targetPc = getPieceAt(pieces, mx, my);
          const visualMy = 8 - my;
          ctx.beginPath();
          ctx.arc(mx * CELL_SIZE + CELL_SIZE / 2, visualMy * CELL_SIZE + CELL_SIZE / 2, 12, 0, Math.PI * 2);
          ctx.fillStyle = targetPc ? "rgba(255,30,30,0.55)" : "rgba(20,180,40,0.55)";
          ctx.fill();
        }
      }

      // 拖拽hover预览
      if (drag.active && drag.piece && drag.hoverX !== null && drag.hoverY !== null) {
        const mvList = getValidMoves(pieces, drag.piece, cellType);
        const isValid = mvList.some(([mx, my]) => mx === drag.hoverX && my === drag.hoverY);
        if (isValid) {
          const targetPc = getPieceAt(pieces, drag.hoverX, drag.hoverY);
          const visualHoverY = 8 - drag.hoverY;
          if (targetPc && targetPc.side !== drag.piece.side) {
            if (Math.sin(flashFrame * 0.2) > 0) {
              ctx.fillStyle = "rgba(240,40,40,0.45)";
              ctx.fillRect(drag.hoverX * CELL_SIZE, visualHoverY * CELL_SIZE, CELL_SIZE, CELL_SIZE);
            }
          } else {
            ctx.fillStyle = "rgba(40,180,60,0.35)";
            ctx.fillRect(drag.hoverX * CELL_SIZE, visualHoverY * CELL_SIZE, CELL_SIZE, CELL_SIZE);
          }
        }
      }

      // 绘制棋子
      for (const pc of pieces) {
        ctx.save();
        const visualY = 8 - pc.y;
        const cx = pc.x * CELL_SIZE + CELL_SIZE / 2;
        const cy = visualY * CELL_SIZE + CELL_SIZE / 2;
        ctx.beginPath();
        ctx.arc(cx, cy, CELL_SIZE * 0.38, 0, Math.PI * 2);
        if (selectedPiece === pc) {
          ctx.strokeStyle = "#ffdd00";
          ctx.lineWidth = 4;
          ctx.stroke();
        }
        ctx.fillStyle = pc.side === 'red' ? "#ff4444" : "#3366ff";
        ctx.fill();
        ctx.strokeStyle = "#222";
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.fillStyle = "#fff";
        ctx.font = "bold 22px sans-serif";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(NAME_MAP[pc.animal], cx, cy);
        ctx.restore();
      }

      animId = requestAnimationFrame(draw);
    };

    draw();
    canvas.addEventListener('mousedown', onMouseDown);
    window.addEventListener('mousemove', onMouseMove);
    window.addEventListener('mouseup', onMouseUp);

    return () => {
      cancelAnimationFrame(animId);
      canvas.removeEventListener('mousedown', onMouseDown);
      window.removeEventListener('mousemove', onMouseMove);
      window.removeEventListener('mouseup', onMouseUp);
    };
  }, [cellType, pieces, selectedPiece, drag, flashFrame, onMouseDown, onMouseMove, onMouseUp]);

  return (
    <canvas
      ref={canvasRef}
      width={BOARD_WIDTH}
      height={BOARD_HEIGHT}
      style={{ width: '420px', border: '2px solid #333' }}
    />
  );
};

export default JungleGame;

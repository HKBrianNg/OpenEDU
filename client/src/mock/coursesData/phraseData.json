{"id":235,"tag":"2-42","scenario":"livingroom","level":"kindergarten","phrase":"Don't bounce the ball in the living room.","phrase_cn":"不要在客厅拍球。","phrase_tw":"不要在客廳拍球。"},
{"id":236,"tag":"2-43","scenario":"livingroom","level":"kindergarten","phrase":"Don't pound on the floor.","phrase_cn":"(轻点)不要在地板上跳。","phrase_tw":"不要用力踩地板。"},
{"id":237,"tag":"2-44","scenario":"livingroom","level":"kindergarten","phrase":"Don't shout.","phrase_cn":"不要大吼大叫。","phrase_tw":"不要大聲喊叫。"},
{"id":238,"tag":"2-45","scenario":"livingroom","level":"kindergarten","phrase":"You'll disturb the downstairs neighbors.","phrase_cn":"(噪音太大)会影响楼下邻居。","phrase_tw":"會吵到樓下鄰居。"},
{"id":239,"tag":"2-46","scenario":"livingroom","level":"kindergarten","phrase":"Don't scribble on the wall.","phrase_cn":"不要在墙上乱涂乱画。","phrase_tw":"不要在牆上亂塗亂畫。"},
{"id":240,"tag":"2-47","scenario":"livingroom","level":"kindergarten","phrase":"Throw your trash in the trash.","phrase_cn":"把垃圾扔到垃圾桶里。","phrase_tw":"把垃圾丟進垃圾桶。"},
{"id":241,"tag":"3-01","scenario":"balcony","level":"kindergarten","phrase":"Don't climb on the railing.","phrase_cn":"不要爬护栏。","phrase_tw":"不要攀爬欄杆。"},
{"id":242,"tag":"3-02","scenario":"balcony","level":"kindergarten","phrase":"You're going to fall.","phrase_cn":"你会掉下去的。","phrase_tw":"你會摔下去喔。"},
{"id":243,"tag":"3-03","scenario":"balcony","level":"kindergarten","phrase":"Stay away from the window.","phrase_cn":"离窗户远一点。","phrase_tw":"離窗戶遠一點。"},
{"id":244,"tag":"3-04","scenario":"balcony","level":"kindergarten","phrase":"Don't stick your head out the window.","phrase_cn":"不要把头探到窗户外面。","phrase_tw":"不要把頭伸出窗外。"},
{"id":245,"tag":"3-05","scenario":"balcony","level":"kindergarten","phrase":"Can you hang the laundry with mom?","phrase_cn":"你可以和妈妈一起晾衣服吗？","phrase_tw":"你可以跟媽媽一起晾衣服嗎？"},
{"id":246,"tag":"3-06","scenario":"balcony","level":"kindergarten","phrase":"Can you pass me the hanger, please?","phrase_cn":"你可以帮我递一下衣架吗？","phrase_tw":"可以幫我遞衣架嗎？"},
{"id":247,"tag":"3-07","scenario":"balcony","level":"kindergarten","phrase":"Hang the clothes on the hangers, please.","phrase_cn":"请把衣服挂在衣架上。","phrase_tw":"請把衣服掛在衣架上。"},
{"id":248,"tag":"3-08","scenario":"balcony","level":"kindergarten","phrase":"Clip the socks together.","phrase_cn":"把袜子(用夹子)夹起来。","phrase_tw":"用夾子把襪子夾好。"},
{"id":249,"tag":"3-09","scenario":"balcony","level":"kindergarten","phrase":"The clothes are dry. Let's go and get them.","phrase_cn":"衣服干了，我们去收衣服吧。","phrase_tw":"衣服乾囉，我們去收衣服。"},
{"id":250,"tag":"3-10","scenario":"balcony","level":"kindergarten","phrase":"Put the broom away, please.","phrase_cn":"请把扫把放好。","phrase_tw":"請把掃把放好。"},
{"id":251,"tag":"3-11","scenario":"balcony","level":"kindergarten","phrase":"Can you get a new trash bag, please?","phrase_cn":"你可以拿个新的垃圾袋(过来)吗？","phrase_tw":"可以拿新的垃圾袋過來嗎？"},
{"id":252,"tag":"3-12","scenario":"balcony","level":"kindergarten","phrase":"Open the trash bag and put it in the trash can.","phrase_cn":"把垃圾袋打开，套在垃圾桶上。","phrase_tw":"打開垃圾袋，套在垃圾桶上。"},
{"id":253,"tag":"10-01","scenario":"kiddiespeak","level":"kindergarten","phrase":"I need to poopoo.","phrase_cn":"我要拉粑粑。","phrase_tw":"我要便便。"},
